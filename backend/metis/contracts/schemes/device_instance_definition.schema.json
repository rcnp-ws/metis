{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Metis Device Instance Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "device_id",
    "device_type",
    "definition_version",
    "field_template_bindings"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "device_id": {
      "type": "integer",
      "minimum": 1
    },
    "device_type": {
      "$ref": "#/$defs/identifier"
    },
    "definition_version": {
      "type": "string",
      "minLength": 1
    },
    "field_template_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/binding"
      }
    },
    "options": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "type": "boolean"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "integer_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["first", "last"],
      "properties": {
        "first": {
          "type": "integer",
          "minimum": 0
        },
        "last": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "string_list": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "integer_list": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "binding_value": {
      "oneOf": [
        {
          "$ref": "#/$defs/identifier"
        },
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "$ref": "#/$defs/string_list"
        },
        {
          "$ref": "#/$defs/integer_list"
        },
        {
          "$ref": "#/$defs/integer_range"
        }
      ]
    },
    "binding": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/binding_value"
      }
    }
  }
}