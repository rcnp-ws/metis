{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Metis Device Type Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "device_type",
    "definition_version",
    "variables",
    "fields"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "device_type": {
      "$ref": "#/$defs/identifier"
    },
    "definition_version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "variables": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/variable"
      }
    },
    "options": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/option"
      }
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/field"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "variable": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": {
              "const": "string"
            },
            "description": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": {
              "const": "integer"
            },
            "minimum": {
              "type": "integer",
              "minimum": 0
            },
            "maximum": {
              "type": "integer",
              "minimum": 0
            },
            "description": {
              "type": "string"
            }
          }
        }
      ]
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "default"],
      "properties": {
        "type": {
          "const": "boolean"
        },
        "default": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field_template",
        "quantity",
        "role"
      ],
      "properties": {
        "field_template": {
          "type": "string",
          "pattern": "^/(?:[a-z][a-z0-9]*(?:_[a-z0-9]+)*|[0-9]+|\\{[a-z][a-z0-9]*(?:_[a-z0-9]+)*\\})(?:/(?:[a-z][a-z0-9]*(?:_[a-z0-9]+)*|[0-9]+|\\{[a-z][a-z0-9]*(?:_[a-z0-9]+)*\\}))*$"
        },
        "quantity": {
          "$ref": "#/$defs/identifier"
        },
        "role": {
          "$ref": "#/$defs/identifier"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "enabled_if": {
          "$ref": "#/$defs/identifier"
        }
      }
    }
  }
}